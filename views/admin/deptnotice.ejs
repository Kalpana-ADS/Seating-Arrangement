<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('../partials/sidebar', { currentPage: 'seating' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
        <h2 class="topbar-title"><i class="fas fa-door-open"></i> Department Entrance Notice</h2>
      </div>
      <div class="topbar-right">
        <span class="topbar-user"><i class="fas fa-user-circle"></i> <%= adminName || 'Admin' %></span>
      </div>
    </div>
    
    <!-- College Banner -->
    <div class="admin-college-banner">
      <img src="/images/logo.png" alt="PEC" class="admin-banner-logo" onerror="this.style.display='none';">
      <div class="admin-banner-text">
        <div class="admin-banner-name">PANIMALAR ENGINEERING COLLEGE</div>
        <div class="admin-banner-sub">(Autonomous Institution) &nbsp;·&nbsp; Dept. of AI &amp; Data Science</div>
      </div>
    </div>
    <div class="admin-content">

      <!-- Controls -->
      <div class="dash-card" style="margin-bottom:1.25rem;">
        <div class="filter-row" style="gap:1rem;align-items:flex-end;flex-wrap:wrap;">
          <form action="/admin/deptnotice" method="GET" style="display:flex;gap:0.75rem;align-items:flex-end;flex:1;">
            <input type="hidden" name="from" value="<%= dateFrom || '' %>">
            <input type="hidden" name="to"   value="<%= dateTo   || '' %>">
            <div class="form-group" style="flex:1;margin:0;">
              <label>Filter Year</label>
              <select name="year" class="form-select" onchange="this.form.submit()">
                <option value="">All Years</option>
                <option value="II"  <%= selectedYear==='II' ?'selected':'' %>>II Year</option>
                <option value="III" <%= selectedYear==='III'?'selected':'' %>>III Year</option>
                <option value="IV"  <%= selectedYear==='IV' ?'selected':'' %>>IV Year</option>
              </select>
            </div>
          </form>
          <% const deptNoticePdfParams = []; if (selectedYear) deptNoticePdfParams.push('year=' + selectedYear); if (dateFrom) deptNoticePdfParams.push('from=' + encodeURIComponent(dateFrom)); if (dateTo) deptNoticePdfParams.push('to=' + encodeURIComponent(dateTo)); %>
          <a href="/admin/deptnotice/pdf<%= deptNoticePdfParams.length ? '?' + deptNoticePdfParams.join('&') : '' %>" class="btn-pdf">
            <i class="fas fa-file-pdf"></i> Download Notice PDF
          </a>
          <button onclick="window.print()" class="btn-secondary">
            <i class="fas fa-print"></i> Print
          </button>
          <a href="/admin/seating" class="btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
        </div>
      </div>

      <!-- Notice Board Preview -->
      <div class="dash-card" id="noticePrint">
        <div style="text-align:center;border-bottom:4px solid #0d1b4b;padding-bottom:1rem;margin-bottom:1.25rem;">
          <div style="display:flex;align-items:center;justify-content:center;gap:1rem;margin-bottom:0.5rem;"><img src="/images/logo.png" alt="PEC" style="width:70px;height:70px;object-fit:contain;" onerror="this.style.display='none'"></div><div style="font-size:1.5rem;font-weight:800;color:#0d1b4b;font-family:'Playfair Display',serif;letter-spacing:0.03em;">
            PANIMALAR ENGINEERING COLLEGE
          </div>
          <div style="font-size:0.95rem;color:#444;">(Autonomous Institution)</div>
          <div style="font-size:1rem;color:#1a2f7a;font-weight:700;margin-top:0.2rem;">
            Department of Artificial Intelligence and Data Science
          </div>
          <div style="margin-top:0.75rem;display:inline-block;background:#0d1b4b;color:#fff;padding:0.4rem 1.5rem;border-radius:4px;font-weight:800;font-size:1rem;letter-spacing:0.05em;">
            EXAM SEATING ARRANGEMENT
            <%= selectedYear ? '— ' + selectedYear + ' YEAR' : '— ALL YEARS' %>
          </div>
          <% const displayDateRange = dateFrom && dateTo
              ? `${new Date(dateFrom).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'})} - ${new Date(dateTo).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'})}`
              : new Date(examDate).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'});
          %>
          <div style="font-size:0.88rem;color:#555;margin-top:0.5rem;">
            Exam: <%= examName %> &nbsp;|&nbsp;
            Date: <%= displayDateRange %>
          </div>
        </div>

        <% if (seatings.length === 0) { %>
          <div class="empty-mini" style="padding:3rem;text-align:center;">
            <i class="fas fa-chair" style="font-size:3rem;color:#ccc;display:block;margin-bottom:1rem;"></i>
            <p>No seating data available. Generate seating first.</p>
          </div>
        <% } else { %>

        <!-- Group by Hall Number -->
        <%
          const halls = [...new Set(seatings.map(s => s.hallNumber || 'Unassigned'))].sort();
        %>

        <% halls.forEach(hall => { %>
          <% const hallRows = seatings.filter(s => (s.hallNumber || 'Unassigned') === hall); %>
          <div style="margin-bottom:1.5rem;">
            <div style="background:#0d1b4b;color:#fff;padding:0.55rem 1rem;border-radius:6px 6px 0 0;display:flex;align-items:center;gap:0.75rem;">
              <span style="font-size:1rem;font-weight:800;letter-spacing:0.04em;">
                <i class="fas fa-door-open"></i> HALL NO: <%= hall %>
              </span>
              <span style="margin-left:auto;font-size:0.85rem;color:rgba(255,255,255,0.75);">
                Total: <%= hallRows.reduce((a,r)=>a+r.totalStudents,0) %> students
              </span>
            </div>
            <table class="seating-table" style="border-radius:0 0 6px 6px;overflow:hidden;">
              <thead>
                <tr>
                  <th style="background:#1a2f7a;">Year / Section</th>
                  <th style="background:#1a2f7a;">Register Number Range</th>
                  <th style="background:#1a2f7a;">Seat Numbers</th>
                  <th style="background:#1a2f7a;">Total</th>
                </tr>
              </thead>
              <tbody>
                <% hallRows.forEach((row, idx) => { %>
                  <% const seatEnd = (row.seatStart||1) + row.totalStudents - 1; %>
                <tr>
                  <td><span class="sec-label"><%= (row.year || '').toString().toUpperCase() %> <%= (row.section || '').toString().toUpperCase() %> SEC</span></td>
                  <td class="td-range">
                    <span class="reg-start"><%= row.startRegister %></span>
                    <span class="reg-dash">–</span>
                    <span class="reg-end"><%= row.endRegister %></span>
                  </td>
                  <td style="font-weight:700;color:#0d1b4b;">
                    Seat <%= row.seatStart||1 %> – <%= seatEnd %>
                  </td>
                  <td class="td-total"><strong><%= row.totalStudents %></strong></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% }) %>

        <div class="grand-total-bar">
          <span><i class="fas fa-users"></i> Grand Total Students:</span>
          <strong><%= seatings.reduce((a,r)=>a+r.totalStudents,0) %></strong>
        </div>

        <div style="display:flex;justify-content:space-between;margin-top:2.5rem;padding-top:1rem;border-top:1px dashed #ccc;font-size:0.9rem;color:#333;">
          <div>Examination Controller Signature: _______________________</div>
          <div>Head of Department Signature: _______________________</div>
        </div>
        <% } %>
      </div>

    </div>
  </div>
</div>
<style>
@media print {
  .sidebar, .admin-topbar, .dash-card:first-child, .btn-pdf, .btn-secondary, .sidebar-toggle { display: none !important; }
  .admin-main { margin-left: 0 !important; }
  #noticePrint { box-shadow: none; border: none; }
}
</style>
<%- include('../partials/footer') %>
