<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('../partials/sidebar', { currentPage: 'invigilator' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
        <h3 class="topbar-title"><i class="fas fa-user-tie"></i> Invigilator Allocation System</h3>
      </div>
      <div class="topbar-right">
        <span class="topbar-user"><i class="fas fa-user-circle"></i> <%= adminName %></span>
      </div>
    </div>

    <div class="admin-college-banner">
      <img src="/images/logo.png" alt="PEC" class="admin-banner-logo" onerror="this.style.display='none';" style="max-width:60px; height:60px;">
      <div class="admin-banner-text">
        <div class="admin-banner-name">PANIMALAR ENGINEERING COLLEGE</div>
        <div class="admin-banner-sub">(Autonomous) · Dept of AI & Data Science</div>
      </div>
    </div>

    <div class="admin-content">
      <% if(error && error.length){%><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%=error[0]%></div><%}%>
      <% if(success && success.length){%><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%=success[0]%></div><%}%>

      <div style="display:grid; grid-template-columns: 1fr 2fr; gap:20px; margin-bottom:30px;">

        <!-- ═══ LEFT PANEL: Input ═══ -->
        <div>
          <div class="dash-card">
            <div class="dash-card-header"><h4><i class="fas fa-pencil-alt"></i> Create Allocation</h4></div>
            
            <div class="form-group">
              <label>Exam Name <span style="color:red;">*</span></label>
              <input type="text" id="examNameInput" class="form-input" placeholder="Database Exam">
            </div>

            <div class="form-group">
              <label>Subject <span style="color:red;">*</span></label>
              <input type="text" id="subjectInput" class="form-input" placeholder="Database Management">
            </div>

            <div class="form-group">
              <label>Exam Date <span style="color:red;">*</span></label>
              <input type="date" id="examDateInput" class="form-input">
            </div>

            <div class="form-group">
              <label>Session <span style="color:red;">*</span></label>
              <select id="sessionInput" class="form-input">
                <option value="">-- Select --</option>
                <option value="FN">FN (8:15-11:15 AM)</option>
                <option value="AN">AN (12:15-3:15 PM)</option>
              </select>
            </div>

            <button class="btn btn-primary btn-block" onclick="getEligibleStaff()" style="margin-top:10px;">
              <i class="fas fa-search"></i> Get Available Staff (50)
            </button>
          </div>

          <!-- Clear Buttons -->
          <div class="dash-card" style="margin-top:15px;">
            <div class="dash-card-header"><h4><i class="fas fa-trash"></i> Clear Data</h4></div>
            
            <button class="btn btn-warning btn-block" onclick="clearBatch()" style="margin-bottom:8px;">
              <i class="fas fa-refresh"></i> Clear This Month
            </button>

            <button class="btn btn-danger btn-block" onclick="clearAllData()">
              <i class="fas fa-times-circle"></i> Clear ALL Allocations
            </button>
            
            <small style="color:#666; display:block; margin-top:10px;">⚠️ This will reset everything</small>
          </div>
        </div>

        <!-- ═══ RIGHT PANEL: Staff & Results ═══ -->
        <div>
          <!-- Duty Days Info -->
          <div class="dash-card" style="margin-bottom:15px; background:#f0f4ff; border-left:4px solid #1a2f7a;">
            <div class="dash-card-header" style="margin-bottom:10px;">
              <h4><i class="fas fa-calendar-check"></i> Duty Days Limits (Per Month)</h4>
            </div>
            <div style="display:grid; grid-template-columns: repeat(2,1fr); gap:10px; font-size:13px;">
              <div><strong>🎓 Professor:</strong> 3 days max</div>
              <div><strong>👨‍🏫 Assoc. Prof:</strong> 4 days max</div>
              <div><strong>📚 Asst. Prof G1:</strong> 5 days max</div>
              <div><strong>🔬 Asst. Prof LI:</strong> 6 days max</div>
              <div><strong>👩‍💼 Asst. Prof:</strong> 5 days max</div>
              <div><strong>✅ Available:</strong> 50 random staff</div>
            </div>
          </div>

          <!-- Available Staff List -->
          <div class="dash-card">
            <div class="dash-card-header">
              <h4><i class="fas fa-users"></i> Available Staff <span id="availableCount" style="color:#666; font-weight:normal;">(loading...)</span></h4>
            </div>
            
            <div id="staffList" style="max-height:400px; overflow-y:auto;">
              <p style="color:#999; text-align:center; padding:20px;">
                <i class="fas fa-spinner fa-spin"></i> Click "Get Available Staff" to load
              </p>
            </div>

            <div style="margin-top:15px; border-top:1px solid #eee; padding-top:15px;">
              <button class="btn btn-success btn-block" onclick="saveAllocation()">
                <i class="fas fa-save"></i> Save This Allocation
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ RECENT ALLOCATIONS ═══ -->
      <div class="dash-card">
        <div class="dash-card-header"><h4><i class="fas fa-history"></i> Recent Allocations</h4></div>
        
        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Exam Name</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Session</th>
                <th>Staff Count</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if(allocations && allocations.length){ %>
                <% allocations.forEach((a,i)=>{ %>
                  <tr>
                    <td><%=a.examName%></td>
                    <td><%=a.subjectName%></td>
                    <td><%=new Date(a.examDate).toLocaleDateString('en-IN')%></td>
                    <td><span class="badge <%= a.session==='FN'?'badge-info':'badge-warning'%>"><%=a.session%></span></td>
                    <td><strong><%=a.allocations?a.allocations.length:0%></strong></td>
                    <td>
                      <a href="/admin/invigilator/view/<%=a._id%>" class="btn btn-sm btn-info"><i class="fas fa-eye"></i> View</a>
                      <a href="/admin/invigilator/download/<%=a._id%>" class="btn btn-sm btn-success"><i class="fas fa-download"></i> PDF</a>
                      <button onclick="if(confirm('Delete?')){window.location='/admin/invigilator/delete/<%=a._id%>';}" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> Delete</button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" style="text-align:center; color:#999;">No allocations yet</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let selectedStaff = [];

// Get 50 random available staff
async function getEligibleStaff() {
  const examDate = document.getElementById('examDateInput').value;
  if (!examDate) {
    alert('Select exam date first');
    return;
  }

  const batchId = new Date(examDate).toISOString().slice(0, 7);
  
  try {
    const res = await fetch(`/admin/invigilator/eligible?batchId=${batchId}`);
    const data = await res.json();

    if (!data.success) {
      alert('Error: ' + (data.message || 'Failed to get staff'));
      console.error(data);
      return;
    }

    selectedStaff = data.recommended || [];
    
    document.getElementById('availableCount').textContent = `(${selectedStaff.length} available)`;
    
    let html = '<div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px;">';
    selectedStaff.forEach((s, i) => {
      const remaining = s.dutyLimit - s.daysUsed;
      const statusColor = s.isAtLimit ? '#ddd' : (remaining > 2 ? '#e8f5e9' : '#fff9c4');
      
      html += `
        <div style="padding:10px; background:${statusColor}; border:1px solid #ddd; border-radius:4px; cursor:pointer;" 
             onclick="toggleStaff('${s.name}')">
          <div style="font-weight:bold; font-size:12px;">✓ ${s.name}</div>
          <div style="font-size:11px; color:#666;">
            ${s.designation} · ${s.daysUsed}/${s.dutyLimit} days
          </div>
        </div>
      `;
    });
    html += '</div>';
    
    document.getElementById('staffList').innerHTML = html;
  } catch (err) {
    alert('Error: ' + err.message);
    console.error(err);
  }
}

function toggleStaff(name) {
  // Just mark visually - all will be saved
  alert('Staff selected. Click "Save" to confirm allocation.');
}

async function saveAllocation() {
  const examName = document.getElementById('examNameInput').value;
  const subject = document.getElementById('subjectInput').value;
  const examDate = document.getElementById('examDateInput').value;
  const session = document.getElementById('sessionInput').value;

  if (!examName || !subject || !examDate || !session) {
    alert('Fill all fields');
    return;
  }

  if (selectedStaff.length === 0) {
    alert('Get available staff first');
    return;
  }

  const allocations = selectedStaff.map(s => ({
    staffName: s.name,
    designation: s.designation,
    subject: s.subject,
    hallNumber: '',
    session: session
  }));

  const batchId = new Date(examDate).toISOString().slice(0, 7);

  try {
    const res = await fetch('/admin/invigilator/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        examName,
        subjectName: subject,
        examDate,
        session,
        allocations,
        batchId
      })
    });

    const data = await res.json();
    if (data.success) {
      alert('✅ Allocation saved! ID: ' + data.id);
      location.reload();
    } else {
      alert('❌ Error: ' + data.message);
    }
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

async function clearBatch() {
  const examDate = document.getElementById('examDateInput').value;
  if (!examDate) {
    alert('Select month first');
    return;
  }

  if (!confirm('Clear all allocations for this month? This cannot be undone!')) {
    return;
  }

  const batchId = new Date(examDate).toISOString().slice(0, 7);

  try {
    const res = await fetch('/admin/invigilator/clear-batch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ batchId })
    });

    const data = await res.json();
    if (data.success) {
      alert('✅ Cleared ' + data.deletedCount + ' allocations');
      location.reload();
    } else {
      alert('❌ ' + data.message);
    }
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

async function clearAllData() {
  if (!confirm('🚨 DELETE ALL ALLOCATIONS?\n\nThis will remove EVERYTHING. Continue?')) {
    return;
  }
  if (!confirm('⚠️ FINAL WARNING: This action cannot be undone!\n\nDo you really want to continue?')) {
    return;
  }

  try {
    await fetch('/admin/invigilator/clear-all-data', { method: 'POST' });
    alert('✅ All data cleared. Fresh start!');
    location.reload();
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

// Pre-fill today's date
document.getElementById('examDateInput').valueAsDate = new Date();
</script>

<style>
.form-input, .form-group select {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 13px;
}

.btn {
  padding: 8px 16px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: bold;
  font-size: 13px;
  transition: all 0.3s;
}

.btn-primary {
  background: #1a2f7a;
  color: white;
}

.btn-primary:hover {
  background: #0d1b4b;
}

.btn-success {
  background: #4caf50;
  color: white;
}

.btn-success:hover {
  background: #388e3c;
}

.btn-warning {
  background: #ff9800;
  color: white;
}

.btn-warning:hover {
  background: #e68900;
}

.btn-danger {
  background: #f44336;
  color: white;
}

.btn-danger:hover {
  background: #d32f2f;
}

.btn-info {
  background: #2196f3;
  color: white;
  padding: 4px 8px;
  font-size: 12px;
}

.btn-block {
  width: 100%;
  margin: 0;
}

.badge {
  padding: 3px 8px;
  border-radius: 3px;
  font-size: 11px;
  font-weight: bold;
}

.badge-info {
  background: #e3f2fd;
  color: #1976d2;
}

.badge-warning {
  background: #fff3e0;
  color: #f57c00;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.data-table th {
  background: #f5f5f5;
  padding: 10px;
  text-align: left;
  border-bottom: 2px solid #ddd;
  font-weight: bold;
}

.data-table td {
  padding: 10px;
  border-bottom: 1px solid #eee;
}

.data-table tr:hover {
  background: #f9f9f9;
}

.alert {
  padding: 12px 16px;
  border-radius: 4px;
  margin-bottom: 15px;
  font-size: 14px;
}

.alert-success {
  background: #e8f5e9;
  color: #2e7d32;
  border-left: 4px solid #4caf50;
}

.alert-error {
  background: #ffebee;
  color: #c62828;
  border-left: 4px solid #f44336;
}
</style>

<%- include('../partials/footer') %>
