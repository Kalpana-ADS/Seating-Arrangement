# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<db-username>:<db-password>@<cluster-url>/exam_seating?retryWrites=true&w=majority

# ── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-secret-key

# ── Default Admin (created on first run) ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
